{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://codex-patch-studio.local/schemas/feature.schema.json",
  "title": "Codex Patch Studio source-only feature module",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "id",
    "name",
    "description",
    "version",
    "kind",
    "implementation",
    "enabledByDefault",
    "dependencies",
    "conflicts",
    "verification",
    "distribution"
  ],
  "properties": {
    "schemaVersion": { "const": 1 },
    "id": { "$ref": "#/$defs/featureId" },
    "name": { "type": "string", "minLength": 1 },
    "description": { "type": "string", "minLength": 1 },
    "version": { "type": "string", "pattern": "^\\d+\\.\\d+\\.\\d+(?:[-+][0-9A-Za-z.-]+)?$" },
    "kind": { "enum": ["core", "contribution", "local"] },
    "implementation": { "enum": ["builtin", "module"] },
    "entry": { "$ref": "#/$defs/relativePath" },
    "enabledByDefault": { "type": "boolean" },
    "legacyFeatureIds": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 },
      "uniqueItems": true
    },
    "dependencies": {
      "type": "array",
      "items": { "$ref": "#/$defs/featureId" },
      "uniqueItems": true
    },
    "conflicts": {
      "type": "array",
      "items": { "$ref": "#/$defs/featureId" },
      "uniqueItems": true
    },
    "permissions": {
      "description": "Legacy built-in permissions. Independent modules use runtime.permissions.",
      "type": "array",
      "items": { "type": "string", "minLength": 1 },
      "uniqueItems": true
    },
    "supports": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "codexVersions": {
          "type": "array",
          "items": { "$ref": "#/$defs/codexVersion" },
          "uniqueItems": true
        },
        "minimumCodexVersion": {
          "anyOf": [{ "$ref": "#/$defs/codexVersion" }, { "type": "null" }]
        },
        "maximumCodexVersion": {
          "anyOf": [{ "$ref": "#/$defs/codexVersion" }, { "type": "null" }]
        }
      }
    },
    "structuralAnchors": {
      "type": "array",
      "items": { "$ref": "#/$defs/structuralAnchor" }
    },
    "runtime": {
      "type": "object",
      "additionalProperties": false,
      "required": ["permissions", "localPorts"],
      "properties": {
        "permissions": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 },
          "uniqueItems": true
        },
        "localPorts": {
          "type": "array",
          "items": { "$ref": "#/$defs/localPort" }
        }
      }
    },
    "native": {
      "type": "object",
      "additionalProperties": false,
      "required": ["settings", "sidebar"],
      "properties": {
        "settings": {
          "type": "array",
          "items": { "$ref": "#/$defs/nativeAddition" }
        },
        "sidebar": {
          "type": "array",
          "items": { "$ref": "#/$defs/nativeAddition" }
        }
      }
    },
    "verification": {
      "type": "array",
      "items": { "$ref": "#/$defs/verificationMarker" }
    },
    "distribution": {
      "type": "object",
      "additionalProperties": false,
      "required": ["upstreamArtifacts"],
      "properties": {
        "upstreamArtifacts": { "const": "forbidden" }
      }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": { "implementation": { "const": "module" } },
        "required": ["implementation"]
      },
      "then": {
        "required": ["supports", "structuralAnchors", "runtime", "native"],
        "properties": {
          "supports": {
            "required": ["codexVersions"],
            "properties": {
              "codexVersions": { "minItems": 1 }
            }
          },
          "structuralAnchors": { "minItems": 1 },
          "verification": { "minItems": 1 }
        },
        "not": {
          "anyOf": [
            { "required": ["entry"] },
            { "required": ["permissions"] }
          ]
        }
      }
    },
    {
      "if": {
        "properties": { "kind": { "not": { "const": "core" } } },
        "required": ["kind"]
      },
      "then": {
        "properties": { "enabledByDefault": { "const": false } }
      }
    }
  ],
  "$defs": {
    "featureId": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9]*(?:[.-][a-z0-9]+)+$"
    },
    "codexVersion": {
      "type": "string",
      "pattern": "^(?:\\d+(?:\\.\\d+){1,3}(?:[-+][0-9A-Za-z.-]+)?|\\d+\\.\\d+\\.x)$"
    },
    "relativePath": {
      "type": "string",
      "minLength": 1
    },
    "cardinality": {
      "oneOf": [
        { "type": "integer", "minimum": 1 },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["exact"],
          "properties": { "exact": { "type": "integer", "minimum": 1 } }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "anyOf": [{ "required": ["minimum"] }, { "required": ["min"] }],
          "properties": {
            "minimum": { "type": "integer", "minimum": 1 },
            "maximum": { "anyOf": [{ "type": "integer", "minimum": 1 }, { "type": "null" }] },
            "min": { "type": "integer", "minimum": 1 },
            "max": { "anyOf": [{ "type": "integer", "minimum": 1 }, { "type": "null" }] }
          }
        }
      ]
    },
    "fileSelector": {
      "type": "object",
      "additionalProperties": false,
      "anyOf": [{ "required": ["pathIncludes"] }, { "required": ["suffix"] }],
      "properties": {
        "under": { "$ref": "#/$defs/relativePath" },
        "pathIncludes": { "type": "string", "minLength": 1 },
        "suffix": { "type": "string", "minLength": 1 }
      }
    },
    "structuralAnchor": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "includes", "cardinality"],
      "oneOf": [{ "required": ["path"] }, { "required": ["files"] }],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "path": { "$ref": "#/$defs/relativePath" },
        "files": { "$ref": "#/$defs/fileSelector" },
        "includes": { "type": "string", "minLength": 1 },
        "cardinality": { "$ref": "#/$defs/cardinality" }
      }
    },
    "verificationMarker": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "includes"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "path": { "$ref": "#/$defs/relativePath" },
        "includes": { "type": "string", "minLength": 1 },
        "cardinality": { "$ref": "#/$defs/cardinality" }
      }
    },
    "localPort": {
      "oneOf": [
        { "type": "integer", "minimum": 1, "maximum": 65535 },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["port"],
          "properties": {
            "name": { "type": "string", "minLength": 1 },
            "purpose": { "type": "string", "minLength": 1 },
            "port": { "type": "integer", "minimum": 1, "maximum": 65535 },
            "protocol": { "enum": ["tcp", "udp"] },
            "host": { "enum": ["127.0.0.1", "localhost", "::1"] }
          }
        }
      ]
    },
    "nativeAddition": {
      "oneOf": [
        { "type": "string", "minLength": 1 },
        {
          "type": "object",
          "additionalProperties": true,
          "required": ["id"],
          "properties": {
            "id": { "type": "string", "minLength": 1 },
            "label": { "type": "string", "minLength": 1 },
            "route": { "type": "string", "minLength": 1 }
          }
        }
      ]
    }
  }
}
