{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://codex-patch-studio.local/schemas/feature.schema.json",
  "title": "Codex Patch Studio source-only feature module",
  "type": "object",
  "additionalProperties": true,
  "required": ["schemaVersion", "id", "name", "version", "kind", "implementation", "enabledByDefault", "distribution"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "id": { "type": "string", "pattern": "^[a-z][a-z0-9]*(?:[.-][a-z0-9]+)+$" },
    "name": { "type": "string", "minLength": 1 },
    "description": { "type": "string" },
    "version": { "type": "string", "pattern": "^\\d+\\.\\d+\\.\\d+" },
    "kind": { "enum": ["core", "contribution", "local"] },
    "implementation": { "enum": ["builtin", "module"] },
    "entry": { "type": "string" },
    "enabledByDefault": { "type": "boolean" },
    "dependencies": { "type": "array", "items": { "type": "string" }, "uniqueItems": true },
    "conflicts": { "type": "array", "items": { "type": "string" }, "uniqueItems": true },
    "permissions": { "type": "array", "items": { "type": "string" }, "uniqueItems": true },
    "verification": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["path", "includes"],
        "properties": { "path": { "type": "string" }, "includes": { "type": "string" } }
      }
    },
    "distribution": {
      "type": "object",
      "required": ["upstreamArtifacts"],
      "properties": { "upstreamArtifacts": { "const": "forbidden" } }
    }
  }
}
