      "includes": "let Le=await R.ensureWindow();",
      "cardinality": { "exact": 1 }
    }
  ],
  "runtime": { "permissions": ["patch:asar"], "localPorts": [] },
  "native": { "settings": [], "sidebar": [] },
  "verification": [
    {
      "id": "module-receipt",
      "path": "codex-patch-studio/features/core.force-main-window.json",
      "includes": "core.force-main-window",
      "cardinality": { "exact": 1 }
    },
    {
      "id": "delayed-window-ensure",
      "path": ".vite/build/main-*.js",
      "includes": "codex-patch-studio:force-main-window",
      "cardinality": { "exact": 1 }
    }
  ],
  "distribution": { "upstreamArtifacts": "forbidden" }
