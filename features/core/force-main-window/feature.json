{
  "schemaVersion": 1,
  "id": "core.force-main-window",
  "name": "Force Main Window",
  "description": "Optionally forces a visible main window shortly after startup.",
  "version": "1.0.0",
  "kind": "core",
  "implementation": "module",
  "enabledByDefault": false,
  "legacyFeatureIds": ["forceMainWindowStartup"],
  "dependencies": [],
  "conflicts": [],
  "supports": { "codexVersions": ["26.707.x"] },
